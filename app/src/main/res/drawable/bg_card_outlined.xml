<?xml version="1.0" encoding="utf-8"?>
<!-- DESIGN SYSTEM v2: white, border-only card treatment (no shadow) for
     plain View containers - the non-MaterialCardView counterpart to
     Widget.PetCare.Card.Outlined, for grouped info blocks. Not applied to
     any layout by this change. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/corner_radius_card_small" />
    <solid android:color="@color/petcare_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/border_color" />
</shape>
