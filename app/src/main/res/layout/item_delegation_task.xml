<?xml version="1.0" encoding="utf-8"?>
<!-- DESIGN SYSTEM v2: the card was already android:checkable="true" but nothing ever
     set its own checked state (only the inner CheckBox was driven from selection state),
     so a selected task never looked visually different from an unselected one beyond the
     tiny checkbox. DelegationFormFragment.kt now syncs the card's own isChecked, and this
     stroke color reacts to it (coral when selected, neutral otherwise) via the same
     state-list already used for filter chips. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    style="@style/Widget.PetCare.Card.Standard"
    app:cardElevation="@dimen/elevation_level0"
    app:checkedIcon="@null"
    app:strokeColor="@color/chip_stroke_state"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_s">

        <CheckBox
            android:id="@+id/delegation_task_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonTint="@color/primary_coral" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/delegation_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PetCare.CardTitle"
                tools:text="Morning Feeding" />

            <TextView
                android:id="@+id/delegation_task_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.PetCare.Caption"
                tools:text="FEEDING • 8:00 AM" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
