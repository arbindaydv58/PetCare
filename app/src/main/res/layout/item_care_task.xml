<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_m"
    android:clickable="true"
    android:focusable="true"
    style="@style/Widget.PetCare.Card.Standard"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_m">

        <CheckBox
            android:id="@+id/checkbox_complete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/complete_task_content_description"
            app:buttonTint="@color/primary_coral" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.PetCare.CardTitle"
                tools:text="Morning Feeding" />

            <TextView
                android:id="@+id/task_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.PetCare.Caption"
                tools:text="Max • 8:00 AM" />
        </LinearLayout>

        <ImageView
            android:id="@+id/task_item_completed_icon"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:tint="@color/success_green"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btn_edit_task_item"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit_task_content_description"
            android:src="@drawable/ic_edit"
            app:tint="@color/secondary_text" />

        <ImageButton
            android:id="@+id/btn_delegate_task_item"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delegate_task_content_description"
            android:src="@drawable/ic_send"
            app:tint="@color/secondary_text" />

        <ImageButton
            android:id="@+id/btn_delete_task_item"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_task_content_description"
            android:src="@drawable/ic_delete"
            app:tint="@color/error_red" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
