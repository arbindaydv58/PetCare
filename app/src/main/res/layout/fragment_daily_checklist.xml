<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:paddingTop="44dp"
            android:paddingBottom="@dimen/spacing_s">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_go_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/primary_text" />

            <!-- CONSISTENCY FIX: constrained between the back button and the trailing
                 action with ellipsize, so title text can't overlap it under font-scale
                 or localized text expansion. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toStartOf="@id/btn_add_task_toolbar"
                android:layout_toEndOf="@id/btn_back"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/daily_checklist_title"
                android:textAppearance="@style/TextAppearance.PetCare.ScreenTitle" />

            <ImageButton
                android:id="@+id/btn_add_task_toolbar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/add_task_fab_content_description"
                android:src="@drawable/ic_add"
                app:tint="@color/primary_coral" />
        </RelativeLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_l"
            app:cardBackgroundColor="@color/soft_coral"
            app:cardCornerRadius="@dimen/corner_radius_card"
            app:cardElevation="@dimen/elevation_level0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/greeting_pet_parent"
                    android:textAppearance="@style/TextAppearance.PetCare.BodySecondary" />

                <TextView
                    android:id="@+id/daily_date_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_coral"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Tuesday, September 8" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/daily_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    app:indicatorColor="@color/primary_coral"
                    app:trackColor="@color/white"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="12dp" />

                <TextView
                    android:id="@+id/daily_progress_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:textAppearance="@style/TextAppearance.PetCare.CardTitle"
                    tools:text="4 of 7 completed" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_care_tasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_l"
                android:paddingBottom="80dp"
                android:visibility="gone"
                tools:listitem="@layout/item_care_task" />

            <!-- DESIGN SYSTEM v2: same soft-tint icon container + tokenized typography
                 used for every other empty state in the app, instead of a bare faded icon
                 with hardcoded text styling. -->
            <LinearLayout
                android:id="@+id/empty_daily_tasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="@color/petcare_primary_tint">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/primary_coral" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:gravity="center"
                    android:text="@string/empty_daily_checklist"
                    android:textAppearance="@style/TextAppearance.PetCare.SectionHeader" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center"
                    android:text="@string/empty_daily_checklist_description"
                    android:textAppearance="@style/TextAppearance.PetCare.BodySecondary" />
            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/daily_tasks_loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone"
                style="@style/Widget.PetCare.ProgressIndicator.Circular" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_l"
        android:text="@string/add_task_fab_content_description"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary_coral"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white" />

</FrameLayout>
