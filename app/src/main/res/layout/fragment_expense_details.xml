<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:paddingTop="44dp"
            android:paddingBottom="@dimen/spacing_s">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_go_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/primary_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/expense_details_title"
                android:textAppearance="@style/TextAppearance.PetCare.ScreenTitle" />

            <LinearLayout
                android:id="@+id/expense_details_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/btn_edit_expense"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit_expense_content_description"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/primary_coral" />

                <ImageButton
                    android:id="@+id/btn_delete_expense"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/delete_expense_content_description"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/error_red" />
            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/expense_details_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/expense_not_found"
                android:textAppearance="@style/TextAppearance.PetCare.Body"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/expense_details_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary_coral"
                android:visibility="gone" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/expense_details_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <!-- Receipt header card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/soft_coral"
                        app:cardCornerRadius="@dimen/corner_radius_card"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_l">

                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_health_icon">

                                <ImageView
                                    android:id="@+id/expense_details_icon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_receipt_long"
                                    app:tint="@color/primary_text" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tv_expense_category"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_m"
                                android:textColor="@color/primary_coral"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="FOOD" />

                            <TextView
                                android:id="@+id/tv_expense_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.PetCare.ScreenTitle"
                                tools:text="Premium Dog Food" />

                            <TextView
                                android:id="@+id/tv_expense_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_s"
                                android:textColor="@color/primary_coral"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                tools:text="NPR 2,500.00" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

                    <ImageView
                        android:id="@+id/iv_expense_image"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="@dimen/spacing_l"
                        android:background="@drawable/bg_photo_picker"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Info card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.PetCare.Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_l">

                            <include layout="@layout/item_pet_info_row" android:id="@+id/row_expense_pet" />
                            <include layout="@layout/item_pet_info_row" android:id="@+id/row_expense_date" />
                            <include layout="@layout/item_pet_info_row" android:id="@+id/row_expense_payment" />
                            <include layout="@layout/item_pet_info_row" android:id="@+id/row_expense_vendor" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Notes -->
                    <LinearLayout
                        android:id="@+id/section_expense_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_s"
                            android:text="@string/section_notes"
                            android:textAppearance="@style/TextAppearance.PetCare.SectionHeader" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/soft_lavender"
                            app:cardCornerRadius="@dimen/corner_radius_card"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_l">

                                <TextView
                                    android:id="@+id/tv_expense_description"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/primary_text"
                                    android:textSize="15sp"
                                    android:visibility="gone"
                                    tools:text="Bulk order for the month."
                                    tools:visibility="visible" />

                                <TextView
                                    android:id="@+id/tv_expense_notes"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_m"
                                    android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
                                    android:visibility="gone"
                                    tools:text="Bought from the usual store."
                                    tools:visibility="visible" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_xl" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
