<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:paddingHorizontal="@dimen/spacing_xs"
        android:paddingTop="44dp"
        android:paddingBottom="@dimen/spacing_s">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_go_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_text" />

        <TextView
            android:id="@+id/task_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textAppearance="@style/TextAppearance.PetCare.ScreenTitle"
            tools:text="@string/add_task_title" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Photo picker -->
            <FrameLayout
                android:id="@+id/btn_select_task_image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_photo_picker"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_task_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/select_task_photo_content_description"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_task_image_placeholder_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_photo_camera"
                    app:tint="@color/primary_coral" />
            </FrameLayout>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

            <!-- Pet selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/select_pet_label"
                android:textAppearance="@style/TextAppearance.PetCare.CardTitle" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/sp_task_pet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/error_task_pet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.PetCare.Error"
                android:visibility="gone"
                tools:text="@string/error_select_pet"
                tools:visibility="visible" />

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

            <!-- Task Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/section_task_details"
                android:textAppearance="@style/TextAppearance.PetCare.CardTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.PetCare.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/label_task_title"
                        style="@style/Widget.PetCare.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_task_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/error_task_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PetCare.Error"
                        android:visibility="gone"
                        tools:text="@string/error_task_title_required" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:hint="@string/label_category"
                        style="@style/Widget.PetCare.TextInputLayout.ExposedDropdownMenu">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/et_task_category"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:popupBackground="@drawable/bg_dropdown_popup" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

            <!-- Schedule -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/section_schedule"
                android:textAppearance="@style/TextAppearance.PetCare.CardTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.PetCare.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:hint="@string/label_date"
                            app:endIconDrawable="@drawable/ic_calendar"
                            app:endIconMode="custom"
                            style="@style/Widget.PetCare.TextInputLayout">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/btn_task_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/label_time"
                            app:endIconDrawable="@drawable/ic_schedule"
                            app:endIconMode="custom"
                            style="@style/Widget.PetCare.TextInputLayout">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/btn_task_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:text="@string/label_frequency"
                        android:textAppearance="@style/TextAppearance.PetCare.InputLabel" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/sp_task_frequency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_task_freq_once"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:tag="ONCE"
                            android:text="@string/frequency_once" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_task_freq_daily"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:tag="DAILY"
                            android:text="@string/frequency_daily" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_task_freq_weekly"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:tag="WEEKLY"
                            android:text="@string/frequency_weekly" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_task_freq_monthly"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:tag="MONTHLY"
                            android:text="@string/frequency_monthly" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

            <!-- Reminders -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/section_reminders"
                android:textAppearance="@style/TextAppearance.PetCare.CardTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.PetCare.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/local_reminder_title"
                                android:textAppearance="@style/TextAppearance.PetCare.CardTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/local_reminder_description"
                                android:textAppearance="@style/TextAppearance.PetCare.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_reminder_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/primary_coral" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/reminder_offset_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:text="@string/remind_me_label"
                            android:textAppearance="@style/TextAppearance.PetCare.InputLabel" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/sp_reminder_offset"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                app:singleLine="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_offset_0"
                                    style="@style/Widget.PetCare.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:tag="0"
                                    android:text="@string/reminder_at_time" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_offset_5"
                                    style="@style/Widget.PetCare.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:tag="5"
                                    android:text="@string/reminder_5m_before" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_offset_15"
                                    style="@style/Widget.PetCare.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:tag="15"
                                    android:text="@string/reminder_15m_before" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_offset_30"
                                    style="@style/Widget.PetCare.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:tag="30"
                                    android:text="@string/reminder_30m_before" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_offset_60"
                                    style="@style/Widget.PetCare.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:tag="60"
                                    android:text="@string/reminder_1h_before" />
                            </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

            <!-- Requirements -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/section_requirements"
                android:textAppearance="@style/TextAppearance.PetCare.CardTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.PetCare.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/label_supplies_needed"
                        style="@style/Widget.PetCare.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_task_supplies"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_supplies_needed"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:hint="@string/label_extra_instructions"
                        style="@style/Widget.PetCare.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_task_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_task"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:text="@string/action_create_task"
                style="@style/Widget.PetCare.Button.Primary" />

            <ProgressBar
                android:id="@+id/task_form_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_m"
                android:indeterminateTint="@color/primary_coral"
                android:visibility="gone" />

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_xl" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
