<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l">

    <!-- DESIGN SYSTEM v2: icon sits in a soft tinted circular container (matching the
         icon-container convention used everywhere else in the app) instead of a bare
         faded icon, using the new petcare_primary_tint token. -->
    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_circle_white"
        android:backgroundTint="@color/petcare_primary_tint">

        <ImageView
            android:id="@+id/empty_state_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_pets"
            app:tint="@color/primary_coral" />
    </FrameLayout>

    <TextView
        android:id="@+id/empty_state_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.PetCare.SectionHeader"
        tools:text="No pets yet" />

    <TextView
        android:id="@+id/empty_state_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
        tools:text="Add your first pet to start tracking their care journey." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_state_action"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginTop="@dimen/spacing_m"
        android:paddingHorizontal="@dimen/spacing_l"
        style="@style/Widget.PetCare.Button.Primary" />
</LinearLayout>
