<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:paddingHorizontal="@dimen/spacing_xs"
        android:paddingTop="44dp"
        android:paddingBottom="@dimen/spacing_s">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_go_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_text" />

        <TextView
            android:id="@+id/pet_details_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textAppearance="@style/TextAppearance.PetCare.ScreenTitle"
            tools:text="Max" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_edit_pet"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pet_details_edit_content_description"
                android:src="@drawable/ic_edit"
                app:tint="@color/primary_coral" />

            <ImageButton
                android:id="@+id/btn_delete_pet"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pet_details_delete_content_description"
                android:src="@drawable/ic_delete"
                app:tint="@color/error_red" />
        </LinearLayout>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/pet_details_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_xl">

                <!-- Profile card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.PetCare.Card"
                    app:cardElevation="1dp"
                    app:contentPadding="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="260dp">

                            <ImageView
                                android:id="@+id/pet_details_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/pet_image_content_description"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                            <FrameLayout
                                android:id="@+id/pet_details_image_placeholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/soft_coral">

                                <ImageView
                                    android:layout_width="90dp"
                                    android:layout_height="90dp"
                                    android:layout_gravity="center"
                                    android:alpha="0.5"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_pets"
                                    app:tint="@color/primary_coral" />
                            </FrameLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_l">

                            <TextView
                                android:id="@+id/pet_details_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.PetCare.ScreenTitle"
                                tools:text="MAX" />

                            <TextView
                                android:id="@+id/pet_details_species_breed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
                                tools:text="Dog • Golden Retriever" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

                <!-- Stat row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_m"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/soft_blue"
                        app:cardCornerRadius="@dimen/corner_radius_card"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_m">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_monitor_weight"
                                app:tint="@color/info_blue" />

                            <TextView
                                android:id="@+id/pet_details_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_s"
                                android:textAppearance="@style/TextAppearance.PetCare.Stat"
                                tools:text="28.0 kg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_weight_label"
                                android:textAppearance="@style/TextAppearance.PetCare.Caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/soft_yellow"
                        app:cardCornerRadius="@dimen/corner_radius_card"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_m">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_bolt"
                                app:tint="@color/warning_yellow" />

                            <TextView
                                android:id="@+id/pet_details_age"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_s"
                                android:textAppearance="@style/TextAppearance.PetCare.Stat"
                                tools:text="2 yrs" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_age_label"
                                android:textAppearance="@style/TextAppearance.PetCare.Caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

                <!-- Pet Information (closes the Compose gap: DOB/Gender/Dietary/Allergies/
                     Vaccination/Toys/Medical/General were stored in Room but never
                     displayed anywhere in the Compose PetDetailsScreen). -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:text="@string/section_pet_information"
                    android:textAppearance="@style/TextAppearance.PetCare.SectionHeader" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.PetCare.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <include layout="@layout/item_pet_info_row" android:id="@+id/row_dob" />
                        <include layout="@layout/item_pet_info_row" android:id="@+id/row_gender" />
                        <include layout="@layout/item_pet_info_row" android:id="@+id/row_dietary" />
                        <include layout="@layout/item_pet_info_row" android:id="@+id/row_allergies" />
                        <include layout="@layout/item_pet_info_row" android:id="@+id/row_vaccination" />
                        <include layout="@layout/item_pet_info_row" android:id="@+id/row_toys" />
                        <include layout="@layout/item_pet_info_row" android:id="@+id/row_medical" />
                        <include layout="@layout/item_pet_info_row" android:id="@+id/row_general" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_xl" />

                <!-- Care Routines (Stage 4): the Compose PetDetailsScreen accepted
                     onAddCareRoutine/onOpenRoutine callbacks and PetCareNavHost already wired
                     them to correct, working routes, but the Compose screen's body never
                     actually called either - so this pet-scoped section had no live entry
                     point anywhere in the app. Backed by the existing, previously-unused
                     CareRoutineViewModel.observeRoutinesForPet(petId). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_pet_routines"
                        android:textAppearance="@style/TextAppearance.PetCare.SectionHeader" />

                    <TextView
                        android:id="@+id/btn_see_all_routines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_xs"
                        android:text="@string/see_all_routines"
                        android:textColor="@color/primary_coral"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btn_add_routine_from_pet"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_dot_indicator"
                        android:contentDescription="@string/add_routine_content_description"
                        android:padding="7dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/white" />
                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_m" />

                <TextView
                    android:id="@+id/no_pet_routines_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_translucent"
                    android:padding="@dimen/spacing_l"
                    android:text="@string/no_pet_routines"
                    android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/pet_routine_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_xl" />

                <!-- Care Plan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_care_plan"
                        android:textAppearance="@style/TextAppearance.PetCare.SectionHeader" />

                    <ImageButton
                        android:id="@+id/btn_add_task"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_dot_indicator"
                        android:contentDescription="@string/add_task_content_description"
                        android:padding="7dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/white" />
                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_m" />

                <TextView
                    android:id="@+id/no_tasks_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_translucent"
                    android:padding="@dimen/spacing_l"
                    android:text="@string/no_tasks_today"
                    android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/care_task_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_xl" />

                <!-- Healthcare -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_healthcare"
                        android:textAppearance="@style/TextAppearance.PetCare.SectionHeader" />

                    <ImageButton
                        android:id="@+id/btn_add_healthcare"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_dot_indicator"
                        android:contentDescription="@string/add_healthcare_content_description"
                        android:padding="7dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/white" />
                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_m" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/healthcare_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    style="@style/Widget.PetCare.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <TextView
                            android:id="@+id/healthcare_next_due"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:textAppearance="@style/TextAppearance.PetCare.CardTitle"
                            android:visibility="gone"
                            tools:text="Next due: Rabies Shot" />

                        <TextView
                            android:id="@+id/healthcare_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
                            tools:text="No medical records yet." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_xl" />

                <!-- Expenses -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_expenses"
                        android:textAppearance="@style/TextAppearance.PetCare.SectionHeader" />

                    <ImageButton
                        android:id="@+id/btn_add_expense"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_dot_indicator"
                        android:contentDescription="@string/add_expense_content_description"
                        android:padding="7dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/white" />
                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_m" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/expenses_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/soft_lavender"
                    app:cardCornerRadius="@dimen/corner_radius_card"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_spending_label"
                            android:textAppearance="@style/TextAppearance.PetCare.Caption" />

                        <TextView
                            android:id="@+id/expenses_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PetCare.Stat"
                            tools:text="NPR 0.00" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/view_expense_details_prompt"
                            android:textColor="@color/primary_coral"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_delegate_care"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/soft_pink"
                    app:cardCornerRadius="@dimen/corner_radius_card"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_send"
                            app:tint="@color/primary_coral" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_m"
                            android:text="@string/share_care_instructions"
                            android:textColor="@color/primary_coral"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/pet_details_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unable_to_load_pet"
                android:textAppearance="@style/TextAppearance.PetCare.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pet_details_go_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/action_go_back"
                style="@style/Widget.PetCare.Button.Primary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pet_details_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_coral"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
