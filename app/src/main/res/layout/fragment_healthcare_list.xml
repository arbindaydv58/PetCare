<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:paddingTop="44dp"
            android:paddingBottom="@dimen/spacing_s">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_go_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/primary_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toStartOf="@id/btn_add_healthcare"
                android:layout_toEndOf="@id/btn_back"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/healthcare_list_title"
                android:textAppearance="@style/TextAppearance.PetCare.ScreenTitle" />

            <ImageButton
                android:id="@+id/btn_add_healthcare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/add_healthcare_content_description"
                android:src="@drawable/ic_add"
                android:visibility="gone"
                app:tint="@color/primary_coral"
                tools:visibility="visible" />
        </RelativeLayout>

        <TextView
            android:id="@+id/healthcare_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingVertical="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
            tools:text="Health records for Max" />

        <!-- External Integration: lets the user pull vaccination/appointment records from the
             mock veterinary API into the existing healthcare_records table. Uses the same
             uiState (isLoading/successMessage/errorMessage) HealthcareRecordViewModel already
             exposes for manual record save/delete. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_vet_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_import_veterinary_data"
                app:icon="@drawable/ic_sync"
                style="@style/Widget.PetCare.Button.Secondary" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_import"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/spacing_s"
                android:visibility="gone"
                style="@style/Widget.PetCare.ProgressIndicator.Circular"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- DESIGN SYSTEM v2: health summary stat row ("Health summary cards" from the
             approved spec). Both counts are computed in HealthcareListFragment.render()
             purely from latestRecords, a list the fragment already collects and holds -
             no new query, no ViewModel/repository change. -->
        <LinearLayout
            android:id="@+id/healthcare_summary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_m"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/soft_blue"
                app:cardCornerRadius="@dimen/corner_radius_card_small"
                app:cardElevation="@dimen/elevation_level0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_assignment"
                        app:tint="@color/info_blue" />

                    <TextView
                        android:id="@+id/healthcare_total_records_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:textAppearance="@style/TextAppearance.PetCare.Stat"
                        tools:text="6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/healthcare_total_records_label"
                        android:textAppearance="@style/TextAppearance.PetCare.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/soft_yellow"
                app:cardCornerRadius="@dimen/corner_radius_card_small"
                app:cardElevation="@dimen/elevation_level0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_schedule"
                        app:tint="@color/warning_yellow" />

                    <TextView
                        android:id="@+id/healthcare_upcoming_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:textAppearance="@style/TextAppearance.PetCare.Stat"
                        tools:text="2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/healthcare_upcoming_label"
                        android:textAppearance="@style/TextAppearance.PetCare.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Quick category cards - decorative only, matching the Compose HealthcareCategoryRow
             (no click behavior there either). -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/spacing_s"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_l">

                <!-- CONSISTENCY FIX: layout_width/height must be re-specified on <include>
                     whenever other layout_ params (here, layout_marginStart) are set,
                     otherwise Android silently ignores the extra params entirely - these
                     three cards were likely rendering with zero spacing between them. -->
                <include layout="@layout/item_healthcare_category_card"
                    android:id="@+id/category_card_vax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <include layout="@layout/item_healthcare_category_card"
                    android:id="@+id/category_card_meds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_l" />

                <include layout="@layout/item_healthcare_category_card"
                    android:id="@+id/category_card_visits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_l" />

                <include layout="@layout/item_healthcare_category_card"
                    android:id="@+id/category_card_allergy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_l" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_xs"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/healthcare_filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_l"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_healthcare"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_xl"
                android:visibility="gone"
                tools:listitem="@layout/item_healthcare_record" />

            <LinearLayout
                android:id="@+id/tv_empty_healthcare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="@color/petcare_primary_tint">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_medical"
                        app:tint="@color/primary_coral" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:text="@string/empty_healthcare_title"
                    android:textAppearance="@style/TextAppearance.PetCare.SectionHeader" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/empty_healthcare_description"
                    android:textAppearance="@style/TextAppearance.PetCare.BodySecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_add_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:text="@string/action_add_record"
                    android:visibility="gone"
                    style="@style/Widget.PetCare.Button.Primary"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_healthcare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone"
                style="@style/Widget.PetCare.ProgressIndicator.Circular" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
