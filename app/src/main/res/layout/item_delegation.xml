<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_m"
    style="@style/Widget.PetCare.Card.Standard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_m">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_health_icon">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_person"
                app:tint="@color/primary_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/delegation_item_pet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/primary_coral"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Max" />

                <TextView
                    android:id="@+id/delegation_item_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PetCare.Caption"
                    tools:text="08 Sep 2026, 3:30 PM" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/delegation_item_recipient"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.PetCare.CardTitle"
                    tools:text="To: Asmita" />

                <!-- DESIGN SYSTEM v2: every row in this table only exists because its SMS
                     was already sent (DelegationViewModel.saveDelegation() is only called
                     right after the SMS intent launches successfully) - this pill states
                     that existing invariant, it doesn't add a new tracked status. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.PetCare.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/petcare_success_tint">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/spacing_s"
                        android:paddingVertical="3dp"
                        android:text="@string/delegation_sent_status"
                        android:textColor="@color/petcare_success"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- DESIGN SYSTEM v2: recipient phone (delegation.recipientPhone) was already
                 stored but only ever shown as a fallback when no name was given - never
                 alongside a name. Now shown as a secondary contact line when a name is
                 present, so the caregiver's contact info is always visible. -->
            <TextView
                android:id="@+id/delegation_item_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.PetCare.Caption"
                android:visibility="gone"
                tools:text="📞 +9779800000000"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/delegation_item_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
                tools:text="Tasks: Feeding, Walk" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_delete_delegation"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_delegation_content_description"
            android:src="@drawable/ic_delete"
            app:tint="@color/error_red" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
