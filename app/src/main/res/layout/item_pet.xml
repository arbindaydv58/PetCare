<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_l"
    android:clickable="true"
    android:focusable="true"
    style="@style/Widget.PetCare.Card.Standard"
    app:contentPadding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/item_pet_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/pet_image_content_description"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- DESIGN SYSTEM v2: softer tint + full-opacity icon, matching the
                 icon-container treatment used for empty states app-wide, instead
                 of a saturated fill with a half-transparent icon. -->
            <FrameLayout
                android:id="@+id/item_pet_image_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/petcare_primary_tint">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pets"
                    app:tint="@color/primary_coral" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- DESIGN SYSTEM v2: the previous "♥ Healthy" pill here was a static
                 label with no underlying data (no health-status field exists on
                 PetEntity) - removed per "use actual application data, don't
                 hardcode fake information." Replaced with a plain decorative
                 chevron affordance clarifying the existing full-row tap target
                 (same PetAdapter click listener, opens Pet Details where the
                 real Edit/Delete actions live) rather than implying a second,
                 new interaction. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/item_pet_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Max" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        app:cardBackgroundColor="@color/petcare_surface_variant"
                        app:cardCornerRadius="@dimen/corner_radius_pill"
                        app:cardElevation="@dimen/elevation_level0">

                        <TextView
                            android:id="@+id/item_pet_species_breed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/spacing_s"
                            android:paddingVertical="3dp"
                            android:textAppearance="@style/TextAppearance.PetCare.Caption"
                            tools:text="Dog • Golden Retriever" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="@color/petcare_surface_variant">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/secondary_text" />
                </FrameLayout>
            </LinearLayout>

            <!-- DESIGN SYSTEM v2: added small icon prefixes matching Home's weight/age
                 stat cards (same icons/tints), so the same piece of information reads
                 consistently wherever it appears in the app. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/warning_yellow" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xxs"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/item_pet_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PetCare.CardTitle"
                        tools:text="3 yrs" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Age"
                        android:textAppearance="@style/TextAppearance.PetCare.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="@dimen/spacing_xl"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_monitor_weight"
                    app:tint="@color/info_blue" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xxs"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/item_pet_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PetCare.CardTitle"
                        tools:text="20.0 kg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_weight_label"
                        android:textAppearance="@style/TextAppearance.PetCare.Caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
