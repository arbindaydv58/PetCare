<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/spacing_l">

        <!-- DESIGN SYSTEM v2: logo promoted to a subtly elevated card instead of a flat
             circle, matching the same "premium lift" treatment applied to the Profile
             avatar - a small but deliberate first impression cue. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/auth_logo_size"
            android:layout_height="@dimen/auth_logo_size"
            android:layout_marginTop="@dimen/spacing_l"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/corner_radius_pill"
            app:cardElevation="@dimen/elevation_level1">

            <ImageView
                android:layout_width="@dimen/auth_logo_icon_size"
                android:layout_height="@dimen/auth_logo_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@string/auth_logo_content_description"
                android:scaleType="centerInside"
                android:src="@mipmap/petcare_logo" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/login_title"
            android:textAppearance="@style/TextAppearance.PetCare.Heading" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:gravity="center"
            android:text="@string/login_description"
            android:textAppearance="@style/TextAppearance.PetCare.Body" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.PetCare.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_email"
                    app:startIconDrawable="@drawable/ic_mail"
                    app:startIconTint="@color/secondary_text"
                    style="@style/Widget.PetCare.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:hint="@string/label_password"
                    app:endIconContentDescription="@string/content_description_toggle_password"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/secondary_text"
                    style="@style/Widget.PetCare.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- DESIGN SYSTEM v2: inline warning icon via drawableStart - purely a
                     layout attribute, so Kotlin's existing `.text =` / `.isVisible =` calls
                     on this exact TextView are completely unaffected. -->
                <TextView
                    android:id="@+id/error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:drawableStart="@drawable/ic_warning"
                    android:drawablePadding="@dimen/spacing_xs"
                    android:drawableTint="@color/petcare_error"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.PetCare.Error"
                    android:visibility="gone"
                    tools:text="Invalid email or password"
                    tools:visibility="visible" />

                <!-- DESIGN SYSTEM v2: promoted to the shared Button.Link style, compact
                     insets keep it the same size as the plain text it replaces. Only
                     `.isEnabled` is ever called on this id (LoginFragment.render()), which
                     works identically on a MaterialButton. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgot_password"
                    style="@style/Widget.PetCare.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="@dimen/spacing_xs"
                    android:paddingVertical="@dimen/spacing_xxs"
                    android:text="@string/action_forgot_password" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/action_sign_in"
                    style="@style/Widget.PetCare.Button.Primary" />

                <!-- DESIGN SYSTEM v2: the reusable circular progress style from the design
                     system, finally given a real application. Only `.isVisible`/
                     `.visibility` is ever set on this id, unaffected by the widget swap. -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/loading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:visibility="gone"
                    app:indicatorSize="28dp"
                    app:trackThickness="3dp"
                    style="@style/Widget.PetCare.ProgressIndicator.Circular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prompt_no_account"
                android:textColor="@color/secondary_text" />

            <TextView
                android:id="@+id/create_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/spacing_xs"
                android:text="@string/action_create_account"
                android:textColor="@color/primary_coral"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
