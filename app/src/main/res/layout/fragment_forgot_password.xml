<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/spacing_l">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/auth_logo_size"
            android:layout_height="@dimen/auth_logo_size"
            android:layout_marginTop="@dimen/spacing_l"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/corner_radius_pill"
            app:cardElevation="@dimen/elevation_level1">

            <ImageView
                android:layout_width="@dimen/auth_logo_icon_size"
                android:layout_height="@dimen/auth_logo_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@string/auth_logo_content_description"
                android:scaleType="centerInside"
                android:src="@mipmap/petcare_logo" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/forgot_password_title"
            android:textAppearance="@style/TextAppearance.PetCare.Heading" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:gravity="center"
            android:text="@string/forgot_password_description"
            android:textAppearance="@style/TextAppearance.PetCare.Body" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.PetCare.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_email_address"
                    app:startIconDrawable="@drawable/ic_mail"
                    app:startIconTint="@color/secondary_text"
                    style="@style/Widget.PetCare.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/forgot_password_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:drawableStart="@drawable/ic_warning"
                    android:drawablePadding="@dimen/spacing_xs"
                    android:drawableTint="@color/petcare_error"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.PetCare.Error"
                    android:visibility="gone"
                    tools:text="Please enter a valid email address."
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/success_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:drawableStart="@drawable/ic_check_circle"
                    android:drawablePadding="@dimen/spacing_xs"
                    android:drawableTint="@color/success_green"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.PetCare.Caption"
                    android:textColor="@color/success_green"
                    android:visibility="gone"
                    tools:text="Password reset link sent to your email."
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/send_reset"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:text="@string/action_send_link"
                    style="@style/Widget.PetCare.Button.Primary" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/loading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:visibility="gone"
                    app:indicatorSize="28dp"
                    app:trackThickness="3dp"
                    style="@style/Widget.PetCare.ProgressIndicator.Circular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DESIGN SYSTEM v2: promoted to the shared Button.Link style. Only
             `.isEnabled` is ever called on this id (ForgotPasswordFragment.render()),
             which works identically on a MaterialButton. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_to_login"
            style="@style/Widget.PetCare.Button.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_l"
            android:text="@string/action_back_to_login" />
    </LinearLayout>
</ScrollView>
