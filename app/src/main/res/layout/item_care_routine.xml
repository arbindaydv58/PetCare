<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_m"
    android:clickable="true"
    android:focusable="true"
    style="@style/Widget.PetCare.Card.Standard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/iv_routine_image_container"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_task_icon">

                <ImageView
                    android:id="@+id/iv_routine_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_routine_placeholder_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/primary_coral" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_routine_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PetCare.CardTitle"
                    tools:text="Morning Walk" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_routine_pet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
                        tools:text="Max" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/pill_routine_frequency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        style="@style/Widget.PetCare.Pill">

                        <TextView
                            android:id="@+id/tv_routine_frequency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/spacing_s"
                            android:paddingVertical="2dp"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="DAILY" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_edit_routine_item"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/routine_details_edit_content_description"
                android:src="@drawable/ic_edit"
                app:tint="@color/secondary_text" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/border_color" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_routine_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
            android:visibility="gone"
            tools:text="Walk around the block and back."
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/routine_dates_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_routine_start_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted_text"
                android:textSize="12sp"
                tools:text="Starts 8 Sep 2026" />

            <TextView
                android:id="@+id/tv_routine_end_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:textColor="@color/muted_text"
                android:textSize="12sp"
                tools:text="• Ends 8 Oct 2026" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
