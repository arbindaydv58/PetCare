<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:paddingTop="44dp"
            android:paddingBottom="@dimen/spacing_s">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_go_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/primary_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/profile_title"
                android:textAppearance="@style/TextAppearance.PetCare.ScreenTitle" />
        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <!-- Profile header card - gives the avatar/name/email a defined, designed
                     surface instead of floating loose on the screen background, matching the
                     hero-card pattern already used on Routine/Task/Healthcare/Expense details. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/soft_coral"
                    app:cardCornerRadius="@dimen/corner_radius_card"
                    app:cardElevation="@dimen/elevation_level0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <!-- DESIGN SYSTEM v2: avatar promoted to a small elevated card (subtle
                             lift) instead of a flat circle sitting directly on the header - a
                             premium touch matching the "subtle elevation" system fundamental.
                             The inner TextView keeps its id/text-only binding, unaffected. -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="@dimen/corner_radius_pill"
                            app:cardElevation="@dimen/elevation_level1">

                            <TextView
                                android:id="@+id/tv_profile_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="@color/primary_coral"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                tools:text="P" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_profile_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:textAppearance="@style/TextAppearance.PetCare.ScreenTitle"
                            tools:text="Pet Parent" />

                        <!-- DESIGN SYSTEM v2: small mail icon prefix - purely decorative, no
                             new data (still the same FirebaseAuth email string). -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_mail"
                                app:tint="@color/secondary_text" />

                            <TextView
                                android:id="@+id/tv_profile_email"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xxs"
                                android:textAppearance="@style/TextAppearance.PetCare.BodySecondary"
                                tools:text="user@example.com" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

                <!-- Account -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:paddingHorizontal="@dimen/spacing_s"
                    android:text="@string/section_account"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.PetCare.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_xs">

                        <include
                            android:id="@+id/item_notification_settings"
                            layout="@layout/item_profile_menu" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="4dp"
                            android:background="@color/border_color" />

                        <include
                            android:id="@+id/item_delegation_history"
                            layout="@layout/item_profile_menu" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

                <!-- App -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:paddingHorizontal="@dimen/spacing_s"
                    android:text="@string/section_app"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.PetCare.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_xs">

                        <include
                            android:id="@+id/item_about_petcare"
                            layout="@layout/item_profile_menu" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="4dp"
                            android:background="@color/border_color" />

                        <include
                            android:id="@+id/item_privacy_policy"
                            layout="@layout/item_profile_menu" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:text="@string/action_logout"
                    app:icon="@drawable/ic_logout"
                    style="@style/Widget.PetCare.Button.Destructive" />

                <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_xl" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
