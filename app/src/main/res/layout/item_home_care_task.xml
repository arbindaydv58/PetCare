<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:clickable="true"
    android:focusable="true"
    style="@style/Widget.PetCare.Card.Standard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_s">

        <FrameLayout
            android:id="@+id/task_icon_container"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_task_icon">

            <ImageView
                android:id="@+id/task_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_assignment"
                app:tint="@color/petcare_icon_muted_on_surface" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.PetCare.CardTitle"
                tools:text="Feed Max" />

            <TextView
                android:id="@+id/task_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.PetCare.Caption"
                tools:text="8:00 AM" />
        </LinearLayout>

        <ImageView
            android:id="@+id/task_completion_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/home_task_completed_content_description"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/success_green" />

        <View
            android:id="@+id/task_completion_placeholder"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_task_pending_ring"
            android:contentDescription="@string/home_task_pending_content_description"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
